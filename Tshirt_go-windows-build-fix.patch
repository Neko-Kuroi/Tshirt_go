diff --git a/internal/cli/term_unix.go b/internal/cli/term_unix.go
new file mode 100644
index 0000000..3f595a1
--- /dev/null
+++ b/internal/cli/term_unix.go
@@ -0,0 +1,23 @@
+//go:build unix
+
+package cli
+
+import (
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// hideEcho は端末のエコーを止め、元に戻す関数を返す。端末でない場合は ok=false。
+func hideEcho(f *os.File) (restore func(), ok bool) {
+	old, err := unix.IoctlGetTermios(int(f.Fd()), unix.TCGETS)
+	if err != nil {
+		return nil, false
+	}
+	noEcho := *old
+	noEcho.Lflag &^= unix.ECHO
+	if err := unix.IoctlSetTermios(int(f.Fd()), unix.TCSETS, &noEcho); err != nil {
+		return nil, false
+	}
+	return func() { unix.IoctlSetTermios(int(f.Fd()), unix.TCSETS, old) }, true
+}
diff --git a/internal/cli/term_windows.go b/internal/cli/term_windows.go
new file mode 100644
index 0000000..a49f861
--- /dev/null
+++ b/internal/cli/term_windows.go
@@ -0,0 +1,22 @@
+//go:build windows
+
+package cli
+
+import (
+	"os"
+
+	"golang.org/x/sys/windows"
+)
+
+// hideEcho はコンソールのエコーを止め、元に戻す関数を返す。コンソールでない場合は ok=false。
+func hideEcho(f *os.File) (restore func(), ok bool) {
+	h := windows.Handle(f.Fd())
+	var mode uint32
+	if err := windows.GetConsoleMode(h, &mode); err != nil {
+		return nil, false
+	}
+	if err := windows.SetConsoleMode(h, mode&^windows.ENABLE_ECHO_INPUT); err != nil {
+		return nil, false
+	}
+	return func() { windows.SetConsoleMode(h, mode) }, true
+}
